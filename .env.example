# You don't need to copy this: `make plan` asks for region, API key and your
# email, checks them against PagerDuty and writes .env (mode 600, gitignored).
# us or eu
PAGERDUTY_SERVICE_REGION=us
PAGERDUTY_TOKEN=
PD_RESPONDER_EMAIL=
# PD_ROUTING_KEY=          # optional; normally read from terraform output
