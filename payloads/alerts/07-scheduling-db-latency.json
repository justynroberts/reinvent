{
  "event_action": "trigger",
  "dedup_key": "reinvent/scheduling-db/read-latency",
  "client": "Amazon CloudWatch",
  "client_url": "https://console.aws.amazon.com/cloudwatch/home#alarmsV2:",
  "payload": {
    "summary": "RDS scheduling-db: ReadLatency 180ms (threshold 50ms), DatabaseConnections 312 of 400",
    "source": "scheduling-db.c9xk2l.eu-west-1.rds.amazonaws.com",
    "severity": "warning",
    "timestamp": "{{now}}",
    "component": "scheduling-db",
    "group": "aws-eu-west-1",
    "class": "database_latency",
    "custom_details": {
      "service": "{{.Vars.scheduling_service}}",
      "platform": "aws-rds",
      "engine": "postgres 15.6",
      "alarm": "scheduling-db-read-latency-high",
      "read_latency_p99": "180ms (normal 12ms)",
      "connections": "312 of 400 max; retries from scheduling pods that keep restarting",
      "cpu": "41% (normal)",
      "note": "Connection churn from scheduling restarts, not a database fault."
    }
  }
}
