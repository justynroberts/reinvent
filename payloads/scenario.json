{
  "name": "claims-reconciliation memory leak",
  "description": "A library upgrade in claims-reconciliation v2.14.0 leaks memory. The hung pod starves its Kubernetes node, evicting patient-portal and scheduling, and claims submissions back up.",
  "vars": {
    "cluster": "reinvent-kind",
    "namespace": "healthcare",
    "node": "reinvent-control-plane",
    "deployment": "claims-reconciliation",
    "claims_service": "claims-reconciliation",
    "scheduling_service": "scheduling",
    "business_service": "patient-portal",
    "scheduling_tag": "v3.8.2",
    "scheduling_previous_tag": "v3.8.1",
    "scheduling_deployed_ago": "3h",
    "container": "app",
    "image_repo": "registry.internal/claims/claims-reconciliation",
    "image_tag": "v2.14.0",
    "previous_tag": "v2.13.4",
    "library": "x12-claims-parser",
    "library_from": "4.2.1",
    "library_to": "5.0.0",
    "deployed_ago": "47m",
    "repo_url": "https://github.com/example-health/claims-reconciliation"
  },
  "steps": [
    { "name": "Change event: scheduling v3.8.2 (config only, red herring)", "type": "change", "payload": "change-event-scheduling.json", "wait_after": "2s" },
    { "name": "Change event: v2.14.0 rollout (library upgrade)",  "type": "change", "payload": "change-event.json", "wait_after": "3s" },
    { "name": "Noise: probe latency (info, suppressed by EO)",     "type": "alert",  "payload": "alerts/00-probe-noise.json", "wait_after": "2s" },
    { "name": "claims-reconciliation memory leak, worker hung",     "type": "alert",  "payload": "alerts/01-claims-memory-leak.json", "wait_after": "3s" },
    { "name": "Splunk: claims X12 parse error spike",               "type": "alert",  "payload": "alerts/08-claims-error-log-spike.json", "wait_after": "2s" },
    { "name": "scheduling latency + readiness failing",            "type": "alert",  "payload": "alerts/05-scheduling-latency.json", "wait_after": "2s" },
    { "name": "RDS: scheduling-db read latency",                    "type": "alert",  "payload": "alerts/07-scheduling-db-latency.json", "wait_after": "3s" },
    { "name": "Node MemoryPressure, kubelet evicting",              "type": "alert",  "payload": "alerts/02-node-memory-pressure.json", "wait_after": "2s" },
    { "name": "scheduling pods evicted",                            "type": "alert",  "payload": "alerts/03-colocated-pods-evicted.json", "wait_after": "2s" },
    { "name": "scheduling 503s at the ingress",                     "type": "alert",  "payload": "alerts/06-scheduling-503s.json", "wait_after": "2s" },
    { "name": "Synthetics: book-an-appointment journey failing",    "type": "alert",  "payload": "alerts/09-booking-synthetic-failed.json", "wait_after": "3s" },
    { "name": "Claims submission queue backing up",                 "type": "alert",  "payload": "alerts/04-claims-queue-backlog.json", "wait_after": "2s" },
    { "name": "Clearinghouse: 999 acknowledgements overdue",        "type": "alert",  "payload": "alerts/10-clearinghouse-ack-delay.json", "wait_after": "0s" }
  ]
}
